# Copy to .env for local runs. In production set these in Hostinger's environment variables.
# Never commit real values.

# --- LLM ---
LLM_MODE=auto                 # auto (anthropic if key set, else mock) | anthropic | mock
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
REPORT_MODEL=claude-opus-5-5
LLM_EFFORT=low                # low | medium | high (empty = model default)
PRICE_IN_USD_PER_MTOK=4.0     # must match AGENT_MODEL/REPORT_MODEL pricing
PRICE_OUT_USD_PER_MTOK=20.0
USD_INR=85

# --- Caps (INR) ---
RUN_BUDGET_INR=200
DAILY_CAP_INR=1700
MONTHLY_CAP_INR=50000

# --- Shape (do not change without a PRD update) ---
AGENTS_PER_RUN=80
ROUNDS=3
AGENT_BATCH_SIZE=10
MAX_TOKENS_EXTRACT=2400
MAX_TOKENS_AGENT=4000
MAX_TOKENS_REPORT=2000

# --- Abuse ---
IP_RUNS_PER_DAY=5
RELEASE_WINDOW_DAYS=30
TRUST_PROXY=1                 # 1 behind Hostinger/Caddy: client IP from first X-Forwarded-For entry

# --- Links and secrets ---
PUBLIC_BASE_URL=https://salesimulation.aerobee.ai
WINROOM_TRIAL_URL=https://winroom.ai/trial
WEBHOOK_SECRET=
ADMIN_TOKEN=

# --- Email (SMTP with STARTTLS; leave SMTP_HOST empty to write emails to OUTBOX_DIR) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Aerobee Decision Simulator <no-reply@aerobee.ai>
OUTBOX_DIR=data/outbox

# --- Other ---
DATABASE_PATH=data/simulator.db
DISABLE_WORKER=0              # tests only
